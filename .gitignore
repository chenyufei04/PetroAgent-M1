# OPM parameter-sweep working products. These are reproducible from the
# experiment config and are too large/noisy for normal Git history.
# Keep experiment_manifest.json, dataset summaries, analysis reports/figures,
# and case_manifest.json available for review and the FastAPI/Vue UI.
outputs/experiments/*/derived_decks/
outputs/experiments/*/cases/*/flow/
outputs/experiments/*/cases/*/converted/

frontend/node_modules
