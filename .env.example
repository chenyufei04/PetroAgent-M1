# Optional. The deterministic M1 core does not require an LLM key.
OPM_FLOW_BIN=flow
PETRO_AGENT_OUTPUT_DIR=outputs
# OPM Flow 默认由 Windows 通过 WSL2 调用
OPM_EXECUTION_MODE=wsl
OPM_WSL_DISTRIBUTION=Ubuntu-24.04
OPM_FLOW_COMMAND=flow
OPM_FLOW_TIMEOUT_SECONDS=1800

# Neo4j 推荐方式：Docker Compose 在宿主机暴露 7474/7687。
NEO4J_DEPLOYMENT_MODE=docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=petro

# 大模型默认使用 Mock，前后端可在没有 GPU 和模型服务时完成联调。
PETRO_AGENT_LLM_PROVIDER=mock
PETRO_AGENT_LLM_MODEL=qwen3:8b
PETRO_AGENT_LLM_BASE_URL=http://127.0.0.1:11434
PETRO_AGENT_LLM_API_KEY=ollama
PETRO_AGENT_LLM_TIMEOUT_SECONDS=120
PETRO_AGENT_LLM_TEMPERATURE=0.4

# FastAPI 接口访问日志：默认输出到 outputs/logs/api_calls.log，并按大小轮转。
PETRO_AGENT_LOG_DIR=outputs/logs
PETRO_AGENT_API_LOG_FILE=api_calls.log
PETRO_AGENT_LOG_LEVEL=INFO
PETRO_AGENT_LOG_MAX_BYTES=10485760
PETRO_AGENT_LOG_MAX_RECORDS=1000
PETRO_AGENT_LOG_BACKUP_COUNT=5

# 透明访问安全审计：每次进入/刷新首页记录一行 IP，并按 1000 条轮转。
# Cloudflare Quick Tunnel 会提供 CF-Connecting-IP，后端据此识别真实公网来源。
PETRO_AGENT_IP_AUDIT_ENABLED=true
PETRO_AGENT_IP_AUDIT_LOG_FILE=access_ip.log
PETRO_AGENT_IP_AUDIT_MAX_BYTES=1048576
PETRO_AGENT_IP_AUDIT_MAX_RECORDS=1000
PETRO_AGENT_IP_AUDIT_BACKUP_COUNT=10

# API 滑动窗口限流独立运行；页面和静态资源不计入限流额度。
PETRO_AGENT_RATE_LIMIT_ENABLED=true
PETRO_AGENT_RATE_LIMIT_MAX_REQUESTS=120
PETRO_AGENT_RATE_LIMIT_WINDOW_SECONDS=60
PETRO_AGENT_RATE_LIMIT_MAX_TRACKED_IPS=10000

# 兼容旧方式（保留）：直接启动 Neo4j Desktop、虚拟机或本机服务时，
# 将 NEO4J_DEPLOYMENT_MODE 改为 direct；只要 URI、用户、密码和数据库正确，
# PetroAgent Python 代码无需变化。
# NEO4J_DEPLOYMENT_MODE=direct
# NEO4J_URI=bolt://localhost:7687

