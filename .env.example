# Optional. The deterministic M1 core does not require an LLM key.
OPM_FLOW_BIN=flow
PETRO_AGENT_OUTPUT_DIR=outputs
# OPM Flow 默认由 Windows 通过 WSL2 调用
OPM_EXECUTION_MODE=wsl
OPM_WSL_DISTRIBUTION=Ubuntu-24.04
OPM_FLOW_COMMAND=flow
OPM_FLOW_TIMEOUT_SECONDS=1800

# Neo4j 推荐方式：Docker Compose 在宿主机暴露 7474/7687。
NEO4J_DEPLOYMENT_MODE=docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=petro

# 大模型默认使用 Mock，前后端可在没有 GPU 和模型服务时完成联调。
PETRO_AGENT_LLM_PROVIDER=mock
PETRO_AGENT_LLM_MODEL=Qwen/Qwen3-8B
PETRO_AGENT_LLM_BASE_URL=http://127.0.0.1:8001/v1
PETRO_AGENT_LLM_API_KEY=EMPTY
PETRO_AGENT_LLM_TIMEOUT_SECONDS=120
PETRO_AGENT_LLM_TEMPERATURE=0.2

# 兼容旧方式（保留）：直接启动 Neo4j Desktop、虚拟机或本机服务时，
# 将 NEO4J_DEPLOYMENT_MODE 改为 direct；只要 URI、用户、密码和数据库正确，
# PetroAgent Python 代码无需变化。
# NEO4J_DEPLOYMENT_MODE=direct
# NEO4J_URI=bolt://localhost:7687

